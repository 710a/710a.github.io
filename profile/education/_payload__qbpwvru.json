[{"data":1,"prerenderedAt":608},["ShallowReactive",2],{"sanity-NLPorUXA_a-no2_3oyVevAMBp-XZ-77-RLI1qKv0B7Y":3},{"data":4,"sourceMap":254},{"allCompanies":5,"allTeamMembers":110,"globalData":219},[6,41,62,85],{"_id":7,"companyName":1165,"copy":1166,"founded":1178,"invested":1179,"logo":22,"seo":25,"slug":37,"stage":1180,"websiteUrl":1181},"de9a2fd1-a2a4-4b32-9909-19dadd6e1c43","教育背景",[10],{"_key":11,"_type":12,"children":13,"markDefs":19,"style":20},"3fb6b3531126","block",[14],{"_key":15,"_type":16,"marks":17,"text":18},"5587e852bed4","span",[],"本科阶段为西北工业大学软件工程，2022 年 9 月至 2026 年 6 月，综合排名 62/266；英语四级 605、六级 552，计算机三级数据库技术优秀。已推免至西北工业大学软件工程硕士，2026 年 9 月至 2029 年 6 月，导师徐韬，智能感知交互实验室。",[],"normal",null,{"asset":23},{"url":1184},"https://cdn.sanity.io/files/diak0tmr/production/8f409b899eda0a6598e1f59042a10bb28ffc3a6f.svg",{"description":1186,"image":27,"title":1185},"胡健乐的教育背景：西北工业大学软件工程本科与推免硕士，含排名、英语与计算机等级信息。",{"alt":21,"asset":28},{"metadata":29,"url":35},{"dimensions":30},{"_type":31,"aspectRatio":32,"height":33,"width":34},"sanity.imageDimensions",1.9047619047619047,630,1200,"https://cdn.sanity.io/images/diak0tmr/production/57642f3160650fff13a36c9b7546631533865dc2-1200x630.png","教育背景 | 胡健乐",{"_type":1182,"current":1183},"slug","education","https://www.nwpu.edu.cn/",{"_id":42,"companyName":1187,"copy":1188,"founded":1200,"invested":1201,"logo":53,"seo":56,"slug":59,"stage":1202,"websiteUrl":1203},"7273b722-2b70-4e64-812c-8a68f7d5dce3","技术能力",[45],{"_key":46,"_type":12,"children":47,"markDefs":52,"style":20},"bc95ba0caa49",[48],{"_key":49,"_type":16,"marks":50,"text":51},"f6b0c489e0e3",[],"熟练掌握 C、Java 开发技术，能进行基础软件架构设计；熟悉 PostgreSQL，遇到数据库问题时会结合源码查找原因；熟悉 Bootstrap、Vue3，可独立开发前端网页；熟悉 Linux 操作系统。",[],{"asset":54},{"url":1206},"https://cdn.sanity.io/files/diak0tmr/production/bbe762805f8a8f30923897ce054a1805b19f72ae.svg",{"description":1208,"image":21,"title":1207},"胡健乐的技术能力：C、Java、PostgreSQL、Bootstrap、Vue3 与 Linux。","技术能力 | 胡健乐",{"_type":1204,"current":1205},"skills","https://710a.github.io/",{"_id":63,"companyName":1209,"copy":1210,"founded":1222,"invested":1223,"logo":74,"seo":77,"slug":84,"stage":1224,"websiteUrl":1225},"e09f4289-c2c6-402c-bce3-c72db2d75e02","项目经历",[66],{"_key":67,"_type":12,"children":68,"markDefs":73,"style":20},"18dc4735fa97",[69],{"_key":70,"_type":16,"marks":71,"text":72},"de6f3988ebc1",[],"2025 年 9 月在四川华迪公司大数据开发部门担任 Python 开发实习生，带领小组完成抗疫防疫智慧康养平台，通过爬虫采集数据，并用可视化大屏展示疫情与老年康养统计。2025 年 5 月至 6 月作为开发人员完成基于 YOLOv8 与 NCNN 的 Android 工业缺陷检测系统，覆盖缺陷检测、结果记录与数据分析，接入 OpenCV、Camera2 API、Vulkan、本地存储和相册访问。",[],{"asset":75},{"url":1228},"https://cdn.sanity.io/files/diak0tmr/production/4bfda0b43330ee9caf21baa5dbb67c0a2116a383.svg",{"description":1230,"image":79,"title":1229},"胡健乐的项目经历：四川华迪 Python 实习、智慧康养平台，以及 YOLOv8 Android 工业缺陷检测系统。",{"alt":21,"asset":80},{"metadata":81,"url":35},{"dimensions":82},{"_type":31,"aspectRatio":32,"height":33,"width":34},"项目经历 | 胡健乐",{"_type":1226,"current":1227},{"_id":86,"companyName":1231,"copy":1232,"founded":1244,"invested":1245,"logo":97,"seo":100,"slug":107,"stage":1246,"websiteUrl":1247},"08eaeb94-e6ea-4aec-98c7-dba976f736c0","荣誉成果",[89],{"_key":90,"_type":12,"children":91,"markDefs":96,"style":20},"74e8db737c89",[92],{"_key":93,"_type":16,"marks":94,"text":95},"7526ca2acbb5",[],"获得 2026 年优秀毕业生、2025 年本科生国家奖学金、校级一等奖学金、校级优秀大学生与学业先进个人；2024 年获校级二等奖学金、优秀大学生、学业先进个人、学业进步先进个人、崇德先进个人，并两次获优秀共青团员。竞赛与成果包括 2025 MCM Honorable Mention、全国大学生软件测试大赛国三、蓝桥杯视觉艺术设计省二、未来设计师大赛省三、金种子杯省优胜、程序设计实验技能竞赛校二、计算机设计竞赛校三，国家级大创合格结题，以及 2024/2025 年三项软件著作权登记。",[],{"asset":98},{"url":1250},"https://cdn.sanity.io/files/diak0tmr/production/8cabc54021e8a76831d69a208c8b50042ba3b37c.svg",{"description":1252,"image":102,"title":1251},"胡健乐的荣誉成果：奖学金、竞赛奖项、国家级大创与软件著作权登记。",{"alt":21,"asset":103},{"metadata":104,"url":35},{"dimensions":105},{"_type":31,"aspectRatio":32,"height":33,"width":34},"荣誉成果 | 胡健乐",{"_type":1248,"current":1249},"honors","https://710a.github.io/",[111,128,144,159,174,189,204],{"_id":112,"depthMap":113,"name":1253,"normalMap":11